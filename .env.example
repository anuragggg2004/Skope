# =================================================
# SKOPE — Environment Variables Reference
# =================================================
# Copy this to .env and fill in your actual values.
# On Render: set these in Dashboard → Environment tab.
# VITE_ prefix vars MUST also be in Render env so
# the Vite build embeds them into the client bundle.
# =================================================

# ── AI APIs ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Firebase (Client-side — must have VITE_ prefix) ──
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google OAuth ──────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── MongoDB Atlas ─────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ── Admin JWT ─────────────────────────────────────
ADMIN_JWT_SECRET=your-very-long-random-secret-string
